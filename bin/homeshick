#!/usr/bin/env bash
#
# homeshick entry point.
#
# This script is deliberately thin: it wires together three clearly separated
# concerns and does nothing clever itself.
#
#   lib/parse.sh     turns "$@" into a resolved request (see its output
#                    contract) and owns the command registry -- the single
#                    source of truth for what each command accepts and does.
#   lib/dispatch.sh  runs the resolved request and reduces the results to one
#                    exit status.
#   lib/commands/*   the individual command implementations.
#
# Adding a command means adding a row to the registry in lib/parse.sh and an
# implementation in lib/commands/; this file should not need to change.

# The runtime-flag globals below (TALK/SKIP/FORCE/BATCH/VERBOSE) are read by the
# command implementations in lib/commands/, which are sourced on demand and so
# are invisible to shellcheck here.
# shellcheck disable=SC2034
repos="$HOME/.homesick/repos"
# Include all helper functions. The command implementation itself is sourced
# on demand by the dispatcher.
homeshick=${HOMESHICK_DIR:-$HOME/.homesick/repos/homeshick}
# shellcheck source=../lib/exit_status.sh
source "$homeshick/lib/exit_status.sh"
# shellcheck source=../lib/fs.sh
source "$homeshick/lib/fs.sh"
# shellcheck source=../lib/git.sh
source "$homeshick/lib/git.sh"
# shellcheck source=../lib/log.sh
source "$homeshick/lib/log.sh"
# shellcheck source=../lib/prompt.sh
source "$homeshick/lib/prompt.sh"
# shellcheck source=../lib/parse.sh
source "$homeshick/lib/parse.sh"
# shellcheck source=../lib/dispatch.sh
source "$homeshick/lib/dispatch.sh"

# Verify prerequisites and seed the globals the command implementations rely on.
homeshick_setup_environment() {
  type git &>/dev/null || err "$EX_SOFTWARE" "git not found in path"

  if [[ ! -d $repos ]]; then
    mkdir -p "$repos"
  fi

  # T_START is used by refresh/pull to decide whether a castle is outdated.
  # shellcheck disable=SC2034
  T_START=$(date +%s)
  if [[ -z $GIT_VERSION ]]; then
    read -r _ _ GIT_VERSION _ < <(command git --version)
    if [[ ! $GIT_VERSION =~ ([0-9]+)(\.[0-9]+){0,3} ]]; then
      err "$EX_SOFTWARE" "could not determine git version"
    fi
  fi
}

# Initialise the parser's output contract (see lib/parse.sh). These globals are
# the only state shared between parsing, dispatch and the command functions.
exit_status=$EX_SUCCESS
TALK=true
SKIP=false
FORCE=false
BATCH=false
VERBOSE=false
cmd=''
params=()
castle=''
threshhold=''
help_cmd=''

homeshick_setup_environment
homeshick_parse_arguments "$@"
homeshick_run

exit "$exit_status"
