#!/usr/bin/env bash

# bin/homeshick — Entry point for the homeshick CLI.
#
# This file is intentionally thin. All parsing logic lives in lib/cli.sh
# and all dispatch logic lives in lib/dispatch.sh. Adding a new command
# should not require changes to this file — see CONTRIBUTING.md.

repos="$HOME/.homesick/repos"
homeshick=${HOMESHICK_DIR:-$HOME/.homesick/repos/homeshick}

# --- Source core libraries ---
# shellcheck source=../lib/exit_status.sh
source "$homeshick/lib/exit_status.sh"
# shellcheck source=../lib/fs.sh
source "$homeshick/lib/fs.sh"
# shellcheck source=../lib/git.sh
source "$homeshick/lib/git.sh"
# shellcheck source=../lib/log.sh
source "$homeshick/lib/log.sh"
# shellcheck source=../lib/prompt.sh
source "$homeshick/lib/prompt.sh"
# shellcheck source=../lib/cli.sh
source "$homeshick/lib/cli.sh"
# shellcheck source=../lib/dispatch.sh
source "$homeshick/lib/dispatch.sh"

# --- Environment setup ---
exit_status=$EX_SUCCESS

type git &>/dev/null || err "$EX_SOFTWARE" "git not found in path"

if [[ ! -d $repos ]]; then
  mkdir -p "$repos"
fi

# used in pull.sh and refresh.sh
# shellcheck disable=SC2034
T_START=$(date +%s)
if [[ -z $GIT_VERSION ]]; then
  read -r _ _ GIT_VERSION _ < <(command git --version)
  if [[ ! $GIT_VERSION =~ ([0-9]+)(\.[0-9]+){0,3} ]]; then
    err "$EX_SOFTWARE" "could not determine git version"
  fi
fi

# --- Initialize global flag defaults ---
TALK=true
SKIP=false
FORCE=false
BATCH=false
VERBOSE=false

# --- Parse, load, dispatch ---
hs_parse_args "$@"
hs_load_command
hs_dispatch

exit $exit_status
